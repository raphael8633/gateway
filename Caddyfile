# Gateway — Caddy reverse proxy config
# Docs: https://caddyserver.com/docs/caddyfile
#
# 啟動方式: caddy run --config Caddyfile
# 重載設定: caddy reload --config Caddyfile
#
# 新增服務 checklist:
#   1. 在下方加一個 handle 區塊（公開服務直接 reverse_proxy，受保護服務用 import proxy_auth PORT）
#   2. 確認服務本身已設好 base path（見各專案 README）
#   3. caddy reload
{
	# Disable HTTP/3 (QUIC) so UDP 443 is available for WireGuard (wg2)
	servers {
		protocols h1 h2
	}
}

# ─── Reusable snippets ──────────────────────────────────────────────────────
# auth_portal       — gates the surrounding handle behind Authelia (global-auth :9091).
#                     Must include `header_up -Authorization` (M-006: stale browser
#                     Basic Auth triggers Authelia regulation ban otherwise).
# proxy_auth        — `import proxy_auth PORT` inside a handle: auth-gate + reverse_proxy.
# proxy_auth_strip  — `import proxy_auth_strip /prefix PORT` inside a handle: auth-gate,
#                     strip path prefix, then reverse_proxy. Use when the upstream
#                     expects to receive paths without the gateway-side base path.
#
# Upstream checklist when adding a route (see .mistakes/M-001):
#   * Vite `vite preview` frontends reject foreign Host headers by default and
#     answer every request with "Blocked request. This host is not allowed".
#     The project's vite.config.ts must set preview.allowedHosts: ['raphtools.com']
#     (plus any future alias domain served by this Caddyfile).
(auth_portal) {
	forward_auth 127.0.0.1:9091 {
		uri /auth/api/authz/forward-auth
		header_up -Authorization
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		trusted_proxies 127.0.0.1/32 ::1
	}
}

(proxy_auth) {
	import auth_portal
	reverse_proxy localhost:{args[0]}
}

(proxy_auth_strip) {
	route {
		import auth_portal
		uri strip_prefix {args[0]}
		reverse_proxy localhost:{args[1]}
	}
}

raphtools.com {
	# TLS: Caddy auto-HTTPS via Let's Encrypt HTTP-01 challenge (no CF API needed)

	# ─── Access log ──────────────────────────────────────────────────────────
	# JSON lines for scripts/access-stats.py (weekly human/machine counts in the
	# morning brief). Cookie/Authorization headers stay redacted; only the watcher
	# `locale` cookie value is copied out so the en-locale share is measurable.
	log {
		output file /home/ubuntu/data/caddy/access.log {
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 2160h
		}
		format json
	}

	# ─── Baseline response headers ──────────────────────────────────────────
	# Site-wide defaults. `?` sets a header only when the upstream did not send
	# it, so apps and Authelia keep the values they set themselves. One directive
	# per header: several `?` fields in one block apply only when all are absent.
	header ?Strict-Transport-Security "max-age=86400"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?X-Frame-Options "SAMEORIGIN"
	log_append locale {http.request.cookie.locale}

	# ─── Navigation Page (root) ──────────────────────────────────────────────
	handle / {
		import auth_portal
		file_server {
			root /home/ubuntu/projects/gateway/www
		}
	}

	# ─── Global Auth Portal (Authelia SSO; systemd global-auth.service :9091) ─
	handle /auth* {
		reverse_proxy 127.0.0.1:9091
	}

	# ─── Ban Status (public, no auth) ────────────────────────────────────────
	# PUBLIC (intentional): account lockout self-check page.
	handle /ban-status* {
		reverse_proxy localhost:5000
	}

	# ─── Services Status (powers the nav-page status dots) ───────────────────
	# gateway-services-status.service :8030
	handle /services-status.json {
		import proxy_auth 8030
	}

	# ─── Auth Admin UI (admin-ui.service :5000) ──────────────────────────────
	handle /auth-admin* {
		import proxy_auth 5000
	}

	# ─── VPS2 WireGuard VPN 管理面板 (vps2-vpn.service :8011) ────────────────
	# PUBLIC (intentional): app has its own admin password and device workflow.
	handle_path /vpn* {
		reverse_proxy localhost:8011
	}

	# ─── Health Manage (health-manage.service :3002) ─────────────────────────
	handle /health* {
		import proxy_auth 3002
	}

	# ─── Task Hub (task-hub.service :3003) ───────────────────────────────────
	handle /task-hub* {
		import proxy_auth 3003
	}

	# ─── Raph Reader ─────────────────────────────────────────────────────────
	# Backend  /reader/api → :3005 (auth-gated, strip /reader prefix for API)
	# Frontend /reader     → :5174 (auth-gated PWA + assets)
	# A small set of PWA shell assets are exposed publicly so expired/offline
	# clients can still bootstrap and update; user data sits behind the API gate.
	handle /reader/api* {
		encode zstd gzip
		import proxy_auth_strip /reader 3005
	}
	handle /reader {
		redir * /reader/ 308
	}
	# PUBLIC (intentional): PWA shell asset for offline clients; user data remains API-gated.
	handle /reader/sw.js {
		reverse_proxy localhost:5174
	}
	# PUBLIC (intentional): PWA shell asset for offline clients; user data remains API-gated.
	handle /reader/workbox-*.js {
		reverse_proxy localhost:5174
	}
	# PUBLIC (intentional): PWA shell manifest; user data remains API-gated.
	handle /reader/manifest.webmanifest {
		reverse_proxy localhost:5174
	}
	# PUBLIC (intentional): static PWA assets; user data remains API-gated.
	handle /reader/assets/* {
		reverse_proxy localhost:5174
	}
	# PUBLIC (intentional): PWA shell document; user data remains API-gated.
	handle /reader/index.html {
		reverse_proxy localhost:5174
	}
	handle /reader* {
		import proxy_auth 5174
	}

	# ─── EVM Utils (~/projects/evm-utils, stdlib WSGI :8000; grove, safe-pull) ─
	handle /safe-pull* {
		redir * /evm-utils/safe-pull/ 308
	}
	handle /evm-utils* {
		import proxy_auth 8000
	}

	# ─── Tao Conviction Dashboard (bittensor-conviction-watcher :3006) ───────
	# Next.js basePath /tao-conviction; trailing slash redirects to /tao-conviction
	# PUBLIC (intentional): personal dashboard, no sensitive data.
	handle /tao-conviction* {
		reverse_proxy localhost:3006
	}

	# ─── TAO Research Viewer (tao-research-viewer.service :8040) ─────────────
	# Read-only viewer over subtensor-hub research cards; Authelia group:tao-research
	handle /tao-research* {
		import proxy_auth 8040
	}

	# ─── Crisis Watch (crisis-watch-web.service :8001) ───────────────────────
	# Read-only viewer over ~/data/crisis-watch; Authelia group:crisis-watch. App handles its own prefix (no strip).
	handle /crisis-watch* {
		import proxy_auth 8001
	}

	# ─── raph-lib (raph-lib.service :8020) ───────────────────────────────────
	# /lib/private/* is auth-gated (Authelia ACL in
	# global-auth/config/configuration.yml).
	# Legacy private login/logout URLs redirect into the SSO entry to avoid the
	# 403 dead-end described in M-008.
	handle /lib/private/login* {
		redir * /lib/private/ 302
	}
	handle /lib/private/logout* {
		redir * /lib/private/ 302
	}
	handle /lib/private* {
		import proxy_auth_strip /lib 8020
	}
	# PUBLIC (intentional): raph-lib public shelf, static assets, /lib/ → 302
	# /lib/private/; private subtree is handled above. Client-sent SSO headers
	# are dropped so only the forward_auth path can assert a user.
	handle_path /lib/* {
		reverse_proxy localhost:8020 {
			header_up -Remote-User
			header_up -Remote-Groups
		}
	}
	handle /lib {
		redir * /lib/ 308
	}
	# Old /public URLs (already shared links) → /lib; 308 keeps POST bodies.
	handle_path /public/private* {
		redir * /lib/private{uri} 308
	}
	handle_path /public* {
		redir * /lib/public{uri} 308
	}

	# ─── 新服務範本 ───────────────────────────────────────────────────────────
	# Public:    handle /your-path* { reverse_proxy localhost:PORT }
	# Protected: handle /your-path* { import proxy_auth PORT }

	# Unrouted paths (scanners, retired routes) get a real 404 instead of an
	# empty 200, so the access log separates them from served pages.
	handle {
		respond "Not Found" 404
	}
}
